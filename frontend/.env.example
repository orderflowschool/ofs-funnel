# Frontend environment variables (Create React App).
# These are baked in at BUILD time, so set them before/at build on your host.

# The public URL of the backend API (your Render web service URL)
REACT_APP_BACKEND_URL=https://your-backend-domain

# Free-trial length (in days) shown on the OFS Live pages.
# Must match the trial length set on the Whop plan. Defaults to 1 if unset.
REACT_APP_TRIAL_DAYS=1
