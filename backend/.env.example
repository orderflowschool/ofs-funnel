# Backend environment variables.
# Copy to ".env" for local dev, or set these in your host (Render) as env vars.
# NEVER commit the real .env — it holds live secrets.

# MongoDB (Atlas connection string)
MONGO_URL="mongodb+srv://USER:PASSWORD@your-cluster.mongodb.net/?retryWrites=true&w=majority"
DB_NAME="ofs_funnel"

# Comma-separated list of allowed frontend origins (your live site URL)
CORS_ORIGINS="https://your-frontend-domain"

# Airtable
AIRTABLE_PAT="your-airtable-personal-access-token"
AIRTABLE_BASE_ID="appyXzGJggIM4zUPa"
AIRTABLE_TABLE_ID="tbl4EmVSMo5Y8EiSn"

# GoHighLevel
GHL_API_KEY="your-gohighlevel-api-key"
GHL_LOCATION_ID="your-ghl-location-id"

# Calendly
CALENDLY_PAT="your-calendly-personal-access-token"
